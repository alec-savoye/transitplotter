{
  "name": "transitplotter",
  "private": true,
  "version": "0.1.0",
  "description": "Live NYC subway map — backend computes train positions from GTFS-realtime, browser renders.",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "build-static": "tsx scripts/build-static.ts",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "test": "jest --coverage --ci",
    "test:watch": "jest --watch",
    "test:server": "jest --coverage tests/server",
    "test:shared": "jest --coverage tests/shared",
    "typecheck": "tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p server/tsconfig.json"
  },
  "coverageThreshold": {
    "global": {
      "branches": 80,
      "functions": 80,
      "lines": 80,
      "statements": 80
    }
  }
}
    "lint": "eslint . --ext .ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "adm-zip": "^0.5.16",
    "@types/adm-zip": "^0.5.7",
    "@types/geojson": "^7946.0.15",
    "@types/ws": "^8.5.13",
    "better-sqlite3": "^11.7.0",
    "csv-parse": "^5.6.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2",
    "adm-zip": "^0.5.16",
    "csv-parse": "^5.6.0",
    "better-sqlite3": "^11.7.0",
    "@types/adm-zip": "^0.5.7"
  }
}
