# Copy this file to `.env` and fill in your values. `.env` is gitignored.

# MTA Bus Time developer API key (free from https://register.developer.obanyc.com).
# Optional: if unset, the bus layer is simply disabled — subway/ferry still work.
BUS_API_KEY=

# Host directory for persistent data kept OUT of the repo: the cached GTFS
# static SQLite DB, the JSON stores (track records, visits, counts, interp
# metrics), and the containers' node_modules. Use an absolute path outside the
# repo if you want it off your boot drive. Defaults to ./.cache when unset.
# GTFS_CACHE_HOST=./.cache

# Admin overlay password (gates the visitor-stats / data-source-health panel).
# Defaults to "CONFIG" when unset — CHANGE THIS if you expose the server.
# ADMIN_PASSWORD=CONFIG

# Public hostname(s) the Vite dev server is reverse-proxied under (comma-separated).
# Leave unset to allow all hosts (fine when only your proxy can reach the dev port).
# VITE_ALLOWED_HOSTS=your-domain.example
